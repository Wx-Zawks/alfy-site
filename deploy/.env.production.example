# Copy this file to deploy/.env.production on the server. Never commit that copy.

# MySQL credentials: use distinct, randomly generated values of at least 24 characters.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-mysql-root-password
MYSQL_APP_PASSWORD=replace-with-a-long-random-app-password

# At least 32 random characters. Generate it on the server; do not reuse any password.
ALFY_SECURITY_JWT_SECRET=replace-with-a-long-random-jwt-secret

# Created only if the database has no administrator account yet.
ALFY_INITIAL_ADMIN_USERNAME=admin
ALFY_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
